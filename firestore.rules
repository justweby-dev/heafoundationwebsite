rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PRIMITIVE HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'heafoundationofficial@gmail.com' ||
        request.auth.token.email == 'aspertix14@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- VALIDATION HELPERS ---
    function isValidProject(data) {
      return data.title is string && data.title.size() <= 150 &&
             data.description is string && data.description.size() <= 5000 &&
             data.status in ['Active', 'Completed', 'Upcoming'] &&
             data.createdAt is number && data.updatedAt is number;
    }
    
    function isValidStory(data) {
      return data.title is string && data.title.size() <= 150 &&
             data.category is string && data.category.size() <= 100 &&
             data.content is string && data.content.size() <= 20000 &&
             data.createdAt is number && data.updatedAt is number;
    }

    function isValidGalleryItem(data) {
      return data.image is string && data.image.size() <= 1000 &&
             data.createdAt is number;
    }

    function isValidVolunteer(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.status in ['Pending', 'Approved', 'Rejected'] &&
             data.createdAt is number;
    }

    function isValidDonation(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.amount is number &&
             data.transactionId is string && data.transactionId.size() <= 100 &&
             data.status in ['Pending', 'Approved', 'Rejected'] &&
             data.createdAt is number;
    }

    function isValidContactMessage(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.subject is string && data.subject.size() <= 200 &&
             data.message is string && data.message.size() <= 5000 &&
             data.isRead is bool &&
             data.createdAt is number;
    }

    function isValidImpactStat(data) {
      return data.label is string && data.label.size() <= 100 &&
             data.number is string && data.number.size() <= 50 &&
             data.order is number &&
             data.createdAt is number;
    }

    function isValidTeamMember(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.role is string && data.role.size() <= 100 &&
             data.createdAt is number;
    }

    function isValidSettings(data) {
      return data.orgName is string && data.orgName.size() <= 100 &&
             data.updatedAt is number;
    }

    function isValidAdmin(data) {
      return data.email is string && data.email.size() <= 150 &&
             data.role in ['admin'] &&
             data.createdAt is number;
    }
    
    function isValidNewsletterSubscriber(data) {
      return data.email is string && data.email.size() <= 150 &&
             data.createdAt is number;
    }


    // --- PATH RULES ---

    match /projects/{projectId} {
      allow get: if isValidId(projectId);
      allow list: if true;
      allow create, update, delete: if isValidId(projectId);
    }

    match /stories/{storyId} {
      allow get: if isValidId(storyId);
      allow list: if true;
      allow create, update, delete: if isValidId(storyId);
    }

    match /gallery/{galleryId} {
      allow get: if isValidId(galleryId);
      allow list: if true;
      allow create, update, delete: if isValidId(galleryId);
    }

    match /volunteers/{volunteerId} {
      allow get: if isValidId(volunteerId);
      allow list: if true;
      allow create, update, delete: if isValidId(volunteerId);
    }

    match /donations/{donationId} {
      allow get: if isValidId(donationId);
      allow list: if true;
      allow create, update, delete: if isValidId(donationId);
    }

    match /messages/{messageId} {
      allow get: if isValidId(messageId);
      allow list: if true;
      allow create, update, delete: if isValidId(messageId);
    }

    match /impact/{impactId} {
      allow get: if isValidId(impactId);
      allow list: if true;
      allow create, update, delete: if isValidId(impactId);
    }

    match /team/{teamId} {
      allow get: if isValidId(teamId);
      allow list: if true;
      allow create, update, delete: if isValidId(teamId);
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    match /events/{eventId} {
      allow get: if isValidId(eventId);
      allow list: if true;
      allow create, update, delete: if isValidId(eventId);
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId);
      allow list: if true;
      allow create, update, delete: if isValidId(adminId);
    }

    match /newsletter/{subscriberId} {
      allow get: if isValidId(subscriberId);
      allow list: if true;
      allow create, update, delete: if isValidId(subscriberId);
    }
  }
}
